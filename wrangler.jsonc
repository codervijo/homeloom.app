{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homeloom-app",
  "compatibility_date": "2026-04-24",
  "assets": {
    "directory": "./dist",
    // Resolve extension-less clean URLs to their prerendered .html file
    // (/homeschool-laws/california -> california.html) BEFORE the SPA
    // not-found fallback runs. Without this, clean URLs of prerendered
    // pages fall through to /index.html and Googlebot sees the homepage
    // shell (wrong canonical, no page content) even though the .html exists.
    "html_handling": "auto-trailing-slash",
    // Only genuinely unmatched paths (client-only app routes like
    // /dashboard, /child/:id) fall back to the SPA shell.
    "not_found_handling": "single-page-application"
  }
}
